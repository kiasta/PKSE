# Ignore build output
/build/
/*.elf
/*.nro
/*.nsp
/*.nacp
/*.lst
/*.map
/*.npdm
/*.nso

# Ignore VS Code settings
/.vscode/

# Ignore VS settings
/.vs/
*.vcxproj.user
*.suo
*.user
*.userosscache
*.sln.docstates

# Ignore log files
*.log
PKSE.log
debug.log

# Ignore temporary files
*.tmp
*.bak
*.swp
*.swo
*.DS_Store

# Ignore compiler-generated files
*.o
*.d
*.a

# Ignore dependency-specific files
/dependencies/
/libs/

# Ignore ROMFS and data directories if generated dynamically
/romfs/
/data/

# Python cache from the code-generator scripts in tools/
tools/__pycache__/
# PKHeX source/resource files the gen_*.py scripts fetch from GitHub (tools/pkhex_source.py)
tools/.pkhex_cache/

# A raw pixel dump left in the repo root by hand. Nothing in the Makefile, src/, include/ or
# tools/ produces or reads it, and it has never been tracked.
/icons.raw
/PKSE/x64/

# PokeAPI documents gen_formnames.py fetches on demand (same idea as tools/.pkhex_cache)
tools/.pokeapi_cache/

# .NET build output from tools/formdump (the C# helper gen_formnames.py calls). The SOURCE is
# tracked; bin/ and obj/ are regenerated by `dotnet run` and are machine-specific.
tools/formdump/bin/
tools/formdump/obj/

# The development build (make BUILD_TYPE=development) and the host harnesses' build output
/build-development/
/build-harness/

# Local Claude Code settings and notes
/.claude/
